# DeepVault Nexus local configuration example
# Copy to `.env` or export variables in your shell.
# Never commit real credentials, tokens, or production data.

# Microsoft Graph / Entra ID
DEEPVAULT_ENTRA_AUTH_MODE=delegated
DEEPVAULT_ENTRA_BASE_URL=https://graph.microsoft.com/v1.0
DEEPVAULT_ENTRA_TIMEOUT_SECONDS=30
DEEPVAULT_ENTRA_SCOPES=Sites.Read.All,Sites.ReadWrite.All,Sites.Selected,User.Read,Files.Read.All

# Sites list (comma-separated SharePoint site URLs — no spaces)
DEEPVAULT_ENTRA_SITES=

# Human-readable pilot site names (used in logs and UI — order matches DEEPVAULT_ENTRA_SITES)
DEEPVAULT_PILOT_SITE_NAMES=

# DeepVault Entra configuration (https://learn.microsoft.com/en-us/azure/active-directory/develop/scenario-desktop-overview)
DEEPVAULT_ENTRA_APP_ID=
DEEPVAULT_ENTRA_TENANT_ID=
DEEPVAULT_ENTRA_SECRET_ID=
DEEPVAULT_ENTRA_SECRET_VALUE=

# AI-Provider API configuration (https://platform.openai.com/docs/api-reference)
OPENAI_API_KEY=
GEMINI_API_KEY=