# Nexus hosted deployment — copy this file to .env and fill in your values.
# Never commit .env to source control.

# ── Bishop LLM provider ──────────────────────────────────────────────────────
# Which provider the worker uses for Bishop queries.
# Values: openai | gemini | anthropic
BISHOP_PROVIDER=openai

# API keys — only the key for the chosen provider is required at runtime.
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the default model for the chosen provider.
# Leave empty to use the worker default (gpt-4o / gemini-2.0-flash / claude-sonnet-4-6).
BISHOP_MODEL=

# ── Worker mode ───────────────────────────────────────────────────────────────
# Use "hosted" for shared deployments. "local" disables auth entirely.
WORKER_MODE=hosted

# ── Entra SSO (required when WORKER_MODE=hosted) ─────────────────────────────
# Azure tenant ID (Directory ID in the Azure portal).
ENTRA_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Azure application (client) ID registered for Nexus.
ENTRA_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Set to true to enforce JWKS token validation on every /api/* request.
# Set to false only for local development — never false in production.
WORKER_AUTH_ENABLED=true

# ── Operator access ───────────────────────────────────────────────────────────
# Comma-separated list of Entra object IDs (UUIDs) that are granted operator
# privileges (job control, Artifacts panel, Sync controls).
# Leave empty to grant no one operator access.
# Example: OPERATOR_ALLOWLIST=aaaaaaaa-...,bbbbbbbb-...
OPERATOR_ALLOWLIST=

# ── Runtime data ──────────────────────────────────────────────────────────────
# Host path bind-mounted into the worker container as /data/runtime.
# Corpus files and job artifacts are persisted here across container restarts.
# Windows Docker Desktop path — adjust if your runtime data lives elsewhere.
NEXUS_RUNTIME_PATH=C:\deepvault-nexus\data\runtime
