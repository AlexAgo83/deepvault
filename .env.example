# DeepVault Nexus — copy this file to .env.local and fill in your values.
# Never commit .env.local to source control.

# ── AI provider (Bishop queries) ─────────────────────────────────────────────
# Which provider the worker uses for Bishop. Values: openai | gemini | anthropic
BISHOP_PROVIDER=openai

# API keys — only the key for the chosen provider is required at runtime.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the default model (gpt-4.1-mini / gemini-2.0-flash / claude-sonnet-4-6).
BISHOP_MODEL=

# ── Frontend defaults (Vite — only seed Settings on first load) ───────────────
# VITE_WORKER_MODE: "local" (same-origin proxy) or "remote" (explicit URL below).
# VITE_WORKER_URL: required when VITE_WORKER_MODE=remote.
VITE_WORKER_MODE=local
VITE_WORKER_URL=

# Optional: override the Vite dev-server proxy target for /api requests.
# Use this when the frontend runs against the Docker worker (port 8001).
VITE_WORKER_PROXY_TARGET=http://localhost:8000

# ── SharePoint / Microsoft Graph ──────────────────────────────────────────────
DEEPVAULT_ENTRA_AUTH_MODE=delegated
DEEPVAULT_ENTRA_APP_ID=
DEEPVAULT_ENTRA_TENANT_ID=
DEEPVAULT_ENTRA_SECRET_VALUE=

# Comma-separated SharePoint site URLs (no spaces)
DEEPVAULT_ENTRA_SITES=

# Human-readable site names — order must match DEEPVAULT_ENTRA_SITES
DEEPVAULT_PILOT_SITE_NAMES=

# ── Scripts (ingest / evaluate / export) ─────────────────────────────────────
# Set to "live" to use the live corpus instead of mock.
DEEPVAULT_DATA_MODE=mock

# ── Hosted deployment (required only for production Docker setup) ─────────────
# Use "hosted" for shared deployments. "local" disables auth entirely.
WORKER_MODE=local

# Azure tenant and app IDs for JWKS token validation.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Set to true to enforce token validation on every /api/* request.
WORKER_AUTH_ENABLED=false

# Comma-separated Entra object IDs granted operator privileges.
OPERATOR_ALLOWLIST=

# Host path bind-mounted into the worker container as /data/runtime.
NEXUS_RUNTIME_PATH=C:\deepvault-nexus\data\runtime
